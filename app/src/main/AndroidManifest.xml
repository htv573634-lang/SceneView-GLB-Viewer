<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet kept for basic app functionality; CAMERA and AR permissions removed -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SceneViewDemo"
        tools:targetApi="31">

        <!-- Main Launcher Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SceneViewDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Debug-only harness for instrumentation tests. Launches a single demo composable
             directly via an intent extra, bypassing the home list / navigation stack. Not
             declared in src/main so release builds never ship it. See DemoHostActivity.kt. -->
        <activity
            android:name=".DemoHostActivity"
            android:exported="true"
            android:theme="@style/Theme.SceneViewDemo" />

    </application>
</manifest>
